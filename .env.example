# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_coach

# Google Gemini API Key (Optional for basic ATS scoring, recommended for AI features)
